<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light appearance. values-night/themes.xml flips it to dark. -->
    <style name="Theme.ZoeVIP" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/zoe_bg</item>
        <item name="android:statusBarColor">@color/zoe_bg</item>
        <item name="android:navigationBarColor">@color/zoe_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/zoe_accent</item>
        <item name="android:colorControlActivated">@color/zoe_accent</item>
        <item name="android:colorControlHighlight">@color/zoe_ripple</item>
        <item name="android:textColorPrimary">@color/zoe_text</item>
        <item name="android:textColorSecondary">@color/zoe_muted</item>
    </style>
</resources>
